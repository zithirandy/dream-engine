{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/hook.cjs\" SessionStart",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/hook.cjs\" Stop",
            "timeout": 3,
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/hook.cjs\" SessionEnd",
            "timeout": 3,
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ]
  }
}
